#!/usr/bin/env python3
"""列出源码中尚未收录到 crates/i18n 的界面文案。

用法:
    script/i18n-missing            按出现次数列出缺失文案
    script/i18n-missing --settings  仅检查设置页标题和说明
    script/i18n-missing --stale    列出扫描器未找到引用的词条
"""

import os
import re
import sys
import collections

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
I18N_FILES = ("crates/i18n/src/ui.rs", "crates/i18n/src/settings.rs")
SETTINGS_PAGE_DATA = "crates/settings_ui/src/page_data.rs"
SETTINGS_NAMES = {"AI", "LSP", "Prettier", "Vim"}
STRING = r'"((?:[^"\\]|\\[\s\S])+)"'
SETTINGS_PATTERNS = [
    re.compile(r'SettingsPageItem::SectionHeader\(\s*' + STRING),
    re.compile(r'\btitle:\s*' + STRING),
    re.compile(r'\bdescription:\s*(?:Some\(\s*)?' + STRING),
]

PATTERNS = [
    re.compile(r'(?:Label|Headline)::new\(\s*' + STRING),
    re.compile(r'Button::new\(\s*"[^"]*"\s*,\s*' + STRING),
    re.compile(
        r'Tooltip::(?:simple|text|for_action(?:_title)?(?:_in)?|with_meta(?:_in)?)\(\s*'
        + STRING
    ),
    re.compile(r'\b(?:set_placeholder_text|with_placeholder)\(\s*' + STRING),
    re.compile(r'(?:PromptLevel::\w+,|\blocalize_text\(|\bi18n::tr\()\s*' + STRING),
]

SKIP_DIRS = {"target", "node_modules", ".git"}
SKIP_PATHS = ("/gpui/examples/", "/gpui_web/examples/", "/gpui/tests/", "/tests/")


def read_source(relative_path):
    with open(os.path.join(ROOT, relative_path), encoding="utf-8") as handle:
        return handle.read()


def load_keys():
    return {
        key
        for path in I18N_FILES
        for key in re.findall(STRING + r'\s*=>\s*"', read_source(path))
    }


def scan_settings():
    source = read_source(SETTINGS_PAGE_DATA)
    return collections.Counter(
        text
        for pattern in SETTINGS_PATTERNS
        for text in pattern.findall(source)
        if text not in SETTINGS_NAMES
    )


def scan():
    found = scan_settings()
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        normalized = dirpath.replace(os.sep, "/") + "/"
        if any(skip in normalized for skip in SKIP_PATHS):
            continue
        if "/crates/i18n/" in normalized:
            continue
        for filename in filenames:
            if not filename.endswith(".rs"):
                continue
            path = os.path.join(dirpath, filename)
            try:
                with open(path, encoding="utf-8", errors="ignore") as handle:
                    source = handle.read()
            except OSError:
                continue
            for pattern in PATTERNS:
                for text in pattern.findall(source):
                    found[text] += 1
    return found


def main():
    keys = load_keys()
    found = scan_settings() if "--settings" in sys.argv else scan()

    if "--stale" in sys.argv:
        stale = sorted(keys - found.keys())
        for text in stale:
            print(text)
        print(f"\n扫描器未找到 {len(stale)} 条词条的引用。", file=sys.stderr)
        return

    missing = [(count, text) for text, count in found.items() if text not in keys]
    missing.sort(key=lambda item: (-item[0], item[1]))

    for count, text in missing:
        print(f"{count}\t{text}")

    total = len(found)
    covered = total - len(missing)
    print(f"\n已收录 {covered}/{total}，缺失 {len(missing)}。", file=sys.stderr)
    if "--settings" in sys.argv and missing:
        sys.exit(1)


if __name__ == "__main__":
    main()
