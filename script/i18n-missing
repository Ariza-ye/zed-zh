#!/usr/bin/env python3
"""列出源码中尚未收录到 crates/i18n 的界面文案。

用法:
    script/i18n-missing            按出现次数列出缺失文案
    script/i18n-missing --stale    列出词条表里源码已不再使用的文案
"""

import os
import re
import sys
import collections

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
I18N_UI = os.path.join(ROOT, "crates/i18n/src/ui.rs")
I18N_PHRASES = os.path.join(ROOT, "crates/i18n/src/phrases.rs")

# Label::new("...") 与 Button::new(id, "...") 是两个主要入口,
# 渲染前都会经过 i18n::translate。
PATTERNS = [
    re.compile(r'Label::new\(\s*"((?:[^"\\]|\\.)*)"\s*\)'),
    re.compile(r'Label::new\(\s*"((?:[^"\\]|\\.)*)"\s*\.to_string\(\)\s*\)'),
    re.compile(r'Button::new\(\s*"[^"]*"\s*,\s*"((?:[^"\\]|\\.)*)"\s*\)'),
]

SKIP_DIRS = {"target", "node_modules", ".git"}
SKIP_PATHS = ("/gpui/examples/", "/gpui_web/examples/", "/gpui/tests/", "/tests/")


def load_keys(path):
    with open(path, encoding="utf-8") as handle:
        source = handle.read()
    return set(re.findall(r'"((?:[^"\\]|\\.)+)"\s*=>\s*"', source))


def scan():
    found = collections.Counter()
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        normalized = dirpath.replace(os.sep, "/") + "/"
        if any(skip in normalized for skip in SKIP_PATHS):
            continue
        if "/crates/i18n/" in normalized:
            continue
        for filename in filenames:
            if not filename.endswith(".rs"):
                continue
            path = os.path.join(dirpath, filename)
            try:
                with open(path, encoding="utf-8", errors="ignore") as handle:
                    source = handle.read()
            except OSError:
                continue
            for pattern in PATTERNS:
                for text in pattern.findall(source):
                    found[text] += 1
    return found


def main():
    keys = load_keys(I18N_UI)
    found = scan()

    if "--stale" in sys.argv:
        stale = sorted(set(keys) - set(found))
        for text in stale:
            print(text)
        print(f"\n共 {len(stale)} 条词条在源码里已不再使用。", file=sys.stderr)
        return

    missing = [(count, text) for text, count in found.items() if text not in keys]
    missing.sort(key=lambda item: (-item[0], item[1]))

    for count, text in missing:
        print(f"{count}\t{text}")

    total = len(found)
    covered = total - len(missing)
    print(f"\n已收录 {covered}/{total},缺失 {len(missing)}。", file=sys.stderr)


if __name__ == "__main__":
    main()
